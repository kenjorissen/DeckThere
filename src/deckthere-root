#!/usr/bin/env bash
# Installed root-owned by setup.sh; sudo permits only the fixed launcher actions.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

[[ $EUID == 0 && $# == 1 ]] || exit 1
LEASE=/run/deckthere/lease
heartbeat() {
  local uptime rest temporary
  read -r uptime rest </proc/uptime
  temporary=$(mktemp /run/deckthere/lease.XXXXXX)
  printf '%s\n' "${uptime%%.*}" >"$temporary"
  mv -f -- "$temporary" "$LEASE"
}
case "$1" in
  check)
    # Harmless authentication probe: never starts DeckThere or changes state.
    exit 0
    ;;
  keepalive)
    # The service owns this root-only runtime directory.
    [[ -d /run/deckthere ]] || exit 1
    # Distinct status lets the unprivileged UI show shutdown without reading
    # the private runtime directory or adding a new sudo capability.
    [[ ! -e /run/deckthere/stopping ]] || exit 2
    heartbeat
    exit 0
    ;;
  start | start-gui | start-keyboard)
    install -d -o root -g root -m 700 /run/deckthere-launch
    exec 9>/run/deckthere-launch/lock
    flock -n 9 || {
      echo 'Another DeckThere operation is in progress.' >&2
      exit 1
    }
    if /usr/bin/systemctl is-active --quiet deckthere.service; then
      echo 'DeckThere is already running. Close its launcher before switching modes.' >&2
      exit 1
    fi
    mode=terminal
    [[ $1 != start-keyboard ]] || mode=keyboard
    [[ $1 != start-gui ]] || mode=gui
    printf '%s\n' "$mode" >/run/deckthere-launch/mode
    /usr/bin/systemctl start deckthere.service
    exit $?
    ;;
  stop)
    exec /usr/bin/systemctl "$1" deckthere.service
    ;;
  cleanup)
    # Also runs after a forced service kill. Only DeckThere's fixed gadget is eligible.
    exec /usr/bin/python3 -I /home/.deckthere/bin/deckthere_hardware.py
    ;;
  run) ;;
  *) exit 1 ;;
esac

BRIGHTNESS_FILE=/sys/class/backlight/amdgpu_bl0/brightness
BRIGHTNESS_PERCENT_FILE=/home/.deckthere/data/brightness-percent
DMI_PRODUCT_FILE=/sys/class/dmi/id/product_name
brightness=''

# BEGIN BRIGHTNESS_FUNCTIONS
# This file is data, never sourced/executed. Invalid/missing preferences use 1%.
read_brightness_percent() {
  # Six bytes are enough to validate 100 + CRLF and detect excess data.
  # NONBLOCK and NOFOLLOW avoid hanging on a FIFO or following a symlink.
  /usr/bin/python3 -I - "$BRIGHTNESS_PERCENT_FILE" <<'DECKTHERE_PERCENT'
import os
import re
import stat
import sys

percent = 1
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise ValueError("not a regular file")
        data = os.read(fd, 6)
    finally:
        os.close(fd)
    if re.fullmatch(rb"[0-9]{1,3}(?:\r?\n)?", data) is None or int(data) > 100:
        raise ValueError("expected an integer from 0 to 100")
    percent = int(data)
except (OSError, ValueError):
    print("Brightness preference missing/invalid; using 1% (expected integer 0-100).", file=sys.stderr)
print(percent)
DECKTHERE_PERCENT
}

brightness_target() {
  # Only use the empirical curve on the measured OLED model AND range.
  # Do not silently scale it onto LCD/unknown panels with different responses.
  /usr/bin/python3 -I - "$1" "$2" "${DMI_PRODUCT_FILE:-/sys/class/dmi/id/product_name}" <<'DECKTHERE_TARGET'
import sys

maximum, steps = map(int, sys.argv[1:3])
try:
    with open(sys.argv[3], "rb") as stream:
        product = stream.read(64).strip()
except OSError:
    product = b""
if product == b"Galileo" and maximum == 599000:
    anchors = (1207, 3405, 9604, 27086, 76387, 215423,
               279370, 362298, 469843, 593677, 593677)
    index = min(steps // 10, len(anchors) - 2)
    fraction = (steps - index * 10) / 10
    raw = anchors[index] * (anchors[index + 1] / anchors[index]) ** fraction
    print("Brightness mapping: calibrated Galileo OLED steps.", file=sys.stderr)
else:
    raw = maximum * (steps / 100) ** 2.2
    print("Brightness mapping: generic perceptual gamma 2.2 (uncalibrated model/range).", file=sys.stderr)
print(min(maximum, max(0, int(raw + 0.5))))
DECKTHERE_TARGET
}

apply_brightness() {
  local maximum percent target
  brightness_target_raw=''
  next_brightness_notice=0
  percent=$(read_brightness_percent)
  if [[ -r "$BRIGHTNESS_FILE" && -w "$BRIGHTNESS_FILE" &&
    -r "${BRIGHTNESS_FILE%/*}/max_brightness" ]]; then
    maximum=$(<"${BRIGHTNESS_FILE%/*}/max_brightness")
    if [[ ! $maximum =~ ^[0-9]{1,9}$ ]] || ((10#$maximum == 0)); then
      echo 'WARNING: invalid max_brightness; leaving backlight unchanged.' >&2
      return 0
    fi
    brightness=$(<"$BRIGHTNESS_FILE")
    if [[ ! $brightness =~ ^[0-9]{1,9}$ ]]; then
      brightness=''
      echo 'WARNING: invalid original brightness; leaving backlight unchanged.' >&2
      return 0
    fi
    target=$(brightness_target "$maximum" "$percent")
    echo "Saved backlight brightness=$brightness from $BRIGHTNESS_FILE"
    if [[ $brightness == 0 ]]; then
      echo 'WARNING: backlight was already zero at startup; exit will restore zero.' >&2
    fi
    if printf '%s\n' "$target" >"$BRIGHTNESS_FILE"; then
      brightness_target_raw=$target
      echo "Set backlight to configured $percent% ($target of $maximum)."
    else
      echo 'WARNING: could not set backlight brightness.' >&2
    fi
  else
    echo "WARNING: backlight unavailable: $BRIGHTNESS_FILE" >&2
  fi
}

maintain_brightness() {
  local now=$1 current='' message
  [[ -n ${brightness_target_raw:-} && ! -f /run/deckthere/stopping ]] || return 0
  # A failed $(<file) substitution can exit older Bash despite the conditional.
  # Guard read explicitly, accepting a final numeric line without a newline too.
  if ! { IFS= read -r current <"$BRIGHTNESS_FILE" || [[ -n $current ]]; } 2>/dev/null; then
    message='WARNING: brightness watcher could not read backlight.'
  elif [[ ! $current =~ ^[0-9]{1,9}$ ]]; then
    message='WARNING: brightness watcher read an invalid backlight value.'
  elif ((10#$current == brightness_target_raw)); then
    return 0
  elif printf '%s\n' "$brightness_target_raw" 2>/dev/null >"$BRIGHTNESS_FILE"; then
    message="Backlight changed externally ($current); reapplied selected value $brightness_target_raw."
  else
    message='WARNING: brightness watcher could not write backlight.'
  fi
  if ((now >= next_brightness_notice)); then
    echo "$message"
    next_brightness_notice=$((now + 30))
  fi
  return 0
}
# END BRIGHTNESS_FUNCTIONS
child=''
touch_monitor=''
keyboard_backend=''
activity_observer=''
mode=terminal
if [[ -f /run/deckthere-launch/mode ]]; then read -r mode </run/deckthere-launch/mode; fi
[[ $mode == terminal || $mode == gui || $mode == keyboard ]] || exit 1
cleanup() {
  trap - EXIT
  # Backend exit can start cleanup before the launcher requests systemd stop.
  # Ignore subsequent group TERM/INT (also in cleanup's sleeps) so restoration
  # finishes. systemd's bounded SIGKILL escalation still applies if we hang.
  trap '' INT TERM
  # Notify the UI before relighting the screen; cleanup may take a few seconds.
  if ! : >/run/deckthere/stopping; then
    echo 'WARNING: could not signal shutdown to the dashboard.' >&2
  fi
  local pid alive
  local -a children=()
  [[ -z "$child" ]] || children+=("$child")
  [[ -z "$touch_monitor" ]] || children+=("$touch_monitor")
  [[ -z "$keyboard_backend" ]] || children+=("$keyboard_backend")
  [[ -z "$activity_observer" ]] || children+=("$activity_observer")
  for pid in "${children[@]}"; do kill -TERM "$pid" 2>/dev/null || true; done
  for _ in 1 2 3; do
    alive=false
    for pid in "${children[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then alive=true; fi
    done
    "$alive" || break
    sleep 1
  done
  for pid in "${children[@]}"; do
    kill -KILL "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
  # The brightness event reader is now gone, so it cannot race restoration.
  if [[ -n "$brightness" ]]; then
    if printf '%s\n' "$brightness" >"$BRIGHTNESS_FILE"; then
      echo "Restored backlight brightness=$brightness"
    else
      echo "WARNING: could not restore backlight brightness=$brightness" >&2
    fi
  fi
}
trap cleanup EXIT
trap 'exit 0' INT TERM

# Give the launcher a startup grace period, then require regular heartbeats.
rm -f /run/deckthere/stopping
heartbeat
apply_brightness

# Only terminal mode needs corner-hold exit; the keyboard UI has its own quit button.
# The root-only marker is checked in the existing heartbeat loop (no extra polling).
rm -f /run/deckthere/touch-stop
if [[ $mode == terminal ]]; then
  /usr/bin/python3 -I /home/.deckthere/bin/touch-stop.py &
  touch_monitor=$!
fi
/home/.deckthere/bin/vhusbdx86_64 -c /home/.deckthere/data/config.ini &
child=$!
# This observer is dormant until the owner enables automatic sleep. It never
# claims USB interfaces, changes sharing, or requests suspend.
/usr/bin/python3 -I /home/.deckthere/bin/deckthere_activity.py &
activity_observer=$!
if [[ $mode != terminal ]]; then
  backend_options=(--installed)
  [[ $mode != gui ]] || backend_options+=(--no-keyboard)
  /usr/bin/python3 -I /home/.deckthere/bin/deckthere_backend.py "${backend_options[@]}" &
  keyboard_backend=$!
fi
while kill -0 "$child" 2>/dev/null; do
  if [[ -n "$keyboard_backend" ]] && ! kill -0 "$keyboard_backend" 2>/dev/null; then
    echo 'Keyboard backend exited; stopping the session.'
    wait "$keyboard_backend"
    exit $?
  fi
  if [[ $mode == terminal && -f /run/deckthere/touch-stop ]]; then
    echo 'Touchscreen requested shutdown.'
    exit 0
  fi
  if [[ -n "$touch_monitor" ]] && ! kill -0 "$touch_monitor" 2>/dev/null; then
    wait "$touch_monitor" || true
    touch_monitor=''
    echo 'WARNING: touch exit monitor stopped; use local-keyboard Ctrl+C to exit.' >&2
  fi
  read -r uptime _ </proc/uptime
  last=$(<"$LEASE")
  if [[ ! $last =~ ^[0-9]+$ ]] || ((${uptime%%.*} - last >= 10)); then
    echo 'Launcher heartbeat expired; stopping DeckThere.'
    exit 0
  fi
  # Keyboard mode maintains its live volume-button target in the backend instead.
  if [[ $mode == terminal ]]; then maintain_brightness "${uptime%%.*}"; fi
  sleep 1
done
wait "$child"
