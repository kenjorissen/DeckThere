[Unit]
Description=DeckThere
After=network.target
RequiresMountsFor=/home/.deckthere

[Service]
Type=simple
WorkingDirectory=/home/.deckthere/data
RuntimeDirectory=deckthere
# Traverse only: the GUI socket is owner-only; the lease/markers remain root-only.
RuntimeDirectoryMode=0711
# Advisory inhibitors: compositor-specific blanking policies may differ.
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --mode=block --who=DeckThere "--why=Sharing Steam Deck controller" /home/.deckthere/bin/deckthere-root run
ExecStopPost=/home/.deckthere/bin/deckthere-root cleanup
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077

# Deliberately not enabled at boot: the Steam launcher controls its lifetime.
